# Copy this file to a new file named ".env" (remove ".example")
# Then fill in real values below. NEVER commit the real ".env" file to GitHub.

# A long random string used to secure sessions/cookies.
# You can generate one by running this in your terminal:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-this-with-a-random-generated-string

# Where our database lives (leave as-is for Stage 1)
DATABASE_URL=sqlite:///finance_advisor.db

# We'll fill these in during Stage 7 (AI Recommendations)
GEMINI_API_KEY=
OPENAI_API_KEY=
